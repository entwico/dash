{
  "name": "@entwico/dash",
  "version": "1.4.0",
  "description": "Typical reusable utilities shared across projects. Tree-shakable, ESM-only, zero-dependency core.",
  "type": "module",
  "sideEffects": false,
  "author": "admin@entwico.com",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/entwico/dash"
  },
  "scripts": {
    "start": "tsdown --watch",
    "build": "tsdown",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "clear": "rm -rf dist",
    "lint": "eslint --cache src",
    "lint:fix": "pnpm lint --fix",
    "typecheck": "tsc --noEmit",
    "validate": "pnpm lint && pnpm typecheck && pnpm coverage",
    "prepublishOnly": "pnpm build",
    "ci:version": "changeset version && pnpm install --no-frozen-lockfile",
    "ci:publish": "changeset publish"
  },
  "peerDependencies": {
    "clsx": ">=2",
    "react": ">=18",
    "tailwind-merge": ">=2"
  },
  "peerDependenciesMeta": {
    "clsx": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "tailwind-merge": {
      "optional": true
    }
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@entwico/eslint-config": "^8.0.0",
    "@types/node": "^26.6.10",
    "@types/react": "^19.3.2",
    "@vitest/coverage-istanbul": "^5.1.1",
    "clsx": "^2.1.1",
    "eslint": "^10.15.0",
    "react": "^19.3.1",
    "tailwind-merge": "^3.7.1",
    "tsdown": "^0.23.7",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./async": {
      "types": "./dist/async.d.ts",
      "import": "./dist/async.js"
    },
    "./match": {
      "types": "./dist/match.d.ts",
      "import": "./dist/match.js"
    },
    "./cn": {
      "types": "./dist/cn.d.ts",
      "import": "./dist/cn.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./testing/node": {
      "types": "./dist/testing/node.d.ts",
      "import": "./dist/testing/node.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "packageManager": "pnpm@12.23.0"
}
